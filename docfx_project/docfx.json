{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "*.csproj"
          ],
          "src": "../Scaleout.Streaming.TimeWindowing"
        }
      ],
      "dest": "api",
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "../docs",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appTitle": "ScaleOut Time Windowing Library for .NET",
      "_appLogoPath": "images/scaleout_logo.svg",
      "_appFooter": "Copyright &copy; 2017-2026 ScaleOut Software, Inc.",
      "_appFaviconPath": "images/favicon.ico"

    }
  }
}